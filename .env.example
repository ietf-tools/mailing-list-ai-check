# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it. This template is the only credential
# file that belongs in the public repo.

# --- IMAP mail access ---
# IMAP_HOST is required for pulling mail. Point it at the IMAP server that
# hosts the mailing-list archive you want to check. If the server offers a
# documented anonymous/guest login, use that for IMAP_USERNAME/IMAP_PASSWORD;
# otherwise supply real credentials (kept only in this gitignored file).
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# --- Pangram API (AI-text detection) ---
# Required only for scoring (mail-ai-score). Pulling, extraction, and the
# dashboard work without it. Get a key from https://www.pangram.com/
PANGRAM_API_KEY=

# --- Storage ---
# SQLite database path (default: ./data/mail.db; data/ is gitignored).
DATABASE_PATH=

# --- App settings ---
LOG_LEVEL=INFO

# --- Web dashboard (Flask API) ---
# Host/port for the `mail-ai-web` dev server (defaults: 127.0.0.1:8050).
FLASK_HOST=
FLASK_PORT=

# Read-only mode. Set to 1/true to refuse every state-changing request (any
# method other than GET) with a 403: the dashboard and all its data stay usable,
# but pull/extract/score, import, settings and person edits are rejected. Use it
# when exposing the dashboard on an untrusted network. Default: off, except in
# the production container image, which sets it to 1; set 0 there to enable
# dashboard writes.
PUBLIC_READONLY=

# Export switches (independent of read-only mode, since exports are GET
# requests). Set either to 0/false to refuse that download with a 403. They
# cover the bulk downloads only: the dashboard still displays each message, so
# GET /api/messages/<id> returns that message's text regardless.
# ALLOW_EXPORT covers GET /api/export, the full corpus download including
# message bodies; ALLOW_STATS_EXPORT covers GET /api/export/stats, the
# scores/metadata CSV archive, which carries no message text. Both default on.
ALLOW_EXPORT=
ALLOW_STATS_EXPORT=

# Hostnames the web app answers to, comma-separated; the port is ignored and
# `*` disables the check. A request whose Host header names any other host is
# refused with a 400, which blocks DNS-rebinding attacks on a local instance.
# Unset: only localhost, 127.0.0.1 and ::1 when FLASK_HOST is a loopback
# address, and no check for any other bind address. A publicly reachable
# instance should list its public hostname, plus 127.0.0.1 for health checks.
ALLOWED_HOSTS=

# Largest upload accepted by POST /api/import, in MiB (default: 1024). Every
# other endpoint accepts at most 1 MiB. Larger requests are refused with a 413.
MAX_UPLOAD_MB=
